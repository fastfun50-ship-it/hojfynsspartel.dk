# Copy this file to .env.local for local development
# For production, set these in Vercel Dashboard > Settings > Environment Variables (Production + Preview)

# === ADMIN / CMS (CRITICAL SECURITY) ===
# Use a LONG random password (20+ characters). Never reuse this password anywhere else.
# This is currently the ONLY protection for the entire CMS.
#
# NOTE: A strong unique password has been set for this project.
# The value below is ONLY a placeholder — real value lives in .env.local (local) and Vercel envs (prod).
ADMIN_PASSWORD=changeme-strong-password-here

# IMPORTANT: Set a completely DIFFERENT long random string here for the JWT signing key.
# Do NOT use the same value as ADMIN_PASSWORD.
#
# If you leave this empty, login will STILL WORK (it falls back to using ADMIN_PASSWORD).
# However, you will get security warnings in the logs.
# For best security, set a completely different long random string.
ADMIN_JWT_SECRET=another-long-random-string-different-from-password-here

# === BLOB STORAGE (REQUIRED for CMS saves in production) ===
# Create in Vercel: Storage tab -> Blob -> Create Blob Store
# It will auto-add BLOB_READ_WRITE_TOKEN to your project envs (Production + Preview).
# Without this token on Vercel, CMS cannot persist content or image uploads.
# Locally: CMS uses data/*.json (no token needed).
BLOB_READ_WRITE_TOKEN=
# Optional (OIDC-connected stores on Vercel):
# BLOB_STORE_ID=

# === CONTACT FORM (existing) ===
RESEND_API_KEY=your_resend_key
CONTACT_FROM="Højfynsspartel <info@xn--hjfynsspartel-bnb.dk>"
CONTACT_TO=info@xn--hjfynsspartel-bnb.dk

# === OPTIONAL: For future DB migration or other ===
# DATABASE_URL=   (only if you switch to Prisma + Postgres later)
