# === Resend (email service for the contact form) ===
# Get your API key here: https://resend.com/api-keys

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# === SENDER + RECIPIENT (set these AFTER domain verification) ===
# See KONTAKT-FORM-FIX.md for the full guide.
#
# After you have verified højfynsspartel.dk in Resend:
# - You can send FROM any address on the verified domain.
# - You can send TO any email address you want.
#
# Recommended (professional):
# Use Punycode (ASCII) for the actual email address to avoid non-ASCII errors in Resend.
# The display name can have unicode.
# Punycode for højfynsspartel.dk is xn--hjfynsspartel-bnb.dk (get via node: require('punycode').toASCII('højfynsspartel.dk'))
# CONTACT_FROM="Højfynsspartel <info@xn--hjfynsspartel-bnb.dk>"
# CONTACT_TO=info@xn--hjfynsspartel-bnb.dk
# (Your email provider should accept the Punycode or Unicode version for the mailbox.)
#
# IMPORTANT: Make sure you actually have a working inbox for the CONTACT_TO address.
# Resend only *sends* the email. Receiving happens via your normal email provider
# (the one that handles MX records for højfynsspartel.dk).

# While the domain is NOT yet verified, the code falls back to test mode:
# - from: onboarding@resend.dev
# - to: fastfun50@gmail.com (the email tied to your current Resend account)
# This is only for testing the connection. Real leads will not arrive until you verify the domain.
